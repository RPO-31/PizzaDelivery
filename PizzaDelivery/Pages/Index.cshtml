@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Создание заказа</h1>
    <form method="post" class="mx-auto text-start" style="max-width: 640px;">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="SelectedCustomerId" class="form-label">Клиент</label>
            <select asp-for="SelectedCustomerId" class="form-select">
                <option value="">Выберите клиента</option>
                @foreach (var item in Model.Customers)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Пиццы</label>
            <div class="d-grid gap-2">
                @foreach (var item in Model.Pizzas)
                {
                    <div class="form-check">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            name="SelectedPizzaIds"
                            value="@item.Id"
                            id="pizza-@item.Id" />
                        <label class="form-check-label" for="pizza-@item.Id">
                            @item.Name - @item.Price руб.
                        </label>
                    </div>
                }
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Сформировать заказ</button>
    </form>
</div>
